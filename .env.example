# Copy to .env and adjust as needed: cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=echo
POSTGRES_PASSWORD=echo
POSTGRES_DB=echo
DATABASE_URL=postgresql+psycopg://echo:echo@postgres:5432/echo

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=echo
RABBITMQ_DEFAULT_PASS=echo
RABBITMQ_URL=amqp://echo:echo@rabbitmq:5672/%2F
SCAN_QUEUE=scan_requests

# --- Scanning ---
# Images to scan come from the seeded `images` table (db/init/02_seed_images.sql).
SCAN_INTERVAL_SECONDS=900
SCANNER_TYPE=trivy

LOG_LEVEL=INFO
